GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key
GEMINI_PARSE_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDINGS_MODEL=gemini-embedding-001
# Optional. Falls back to GEMINI_PARSE_MODEL. Transcribes uploaded documents.
GEMINI_OCR_MODEL=
ENABLE_PARSE_TEST=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskmaster
DB_DRIVER=neon-http
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth redirect URI example for local dev:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
