GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key
GEMINI_PARSE_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDINGS_MODEL=gemini-embedding-001
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_KEY=your_azure_document_intelligence_key
AZURE_MODEL=prebuilt-read  
ENABLE_PARSE_TEST=true
NEBULA_API_KEY=your_nebula_api_key
NEBULA_API_BASE_URL=https://api.utdnebula.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskmaster
DB_DRIVER=neon-http
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth redirect URI example for local dev:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
